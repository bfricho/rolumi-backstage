{
  "name": "rolumi-backstage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, deployable knowledge portal for the ROLUMI roadmap and supporting documents.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
