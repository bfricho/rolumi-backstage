# App
PORT=3000
NODE_ENV=development
APP_NAME=ROLUMI Backstage
NOINDEX=true
TRUST_PROXY=false
COOKIE_SECURE=false

# Access — replace all three values outside local development
AUTH_USERNAME=rolumi
AUTH_PASSWORD=change-me-local
SESSION_SECRET=change-this-local-session-secret
SESSION_HOURS=12

# Cloudflare Turnstile
# Production always requires Turnstile. This switch is development-only.
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://backstage:backstage@db:5432/backstage
DATABASE_SSL=false
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage
